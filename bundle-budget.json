{
    "$schema": "https://unpkg.com/@next/bundle-analyzer@latest/budget.schema.json",
    "_comment": "ANTIGRAVITY FP-INFRA-001 — Bundle size budgets for CI enforcement",
    "budgets": [
        {
            "path": "/_next/static/chunks/*.js",
            "maxSize": "100KB",
            "type": "page-chunk",
            "description": "No single page chunk > 100KB gzipped"
        },
        {
            "path": "/_next/static/chunks/framework-*.js",
            "maxSize": "150KB",
            "type": "framework",
            "description": "React + Next.js framework chunk"
        },
        {
            "path": "/_next/static/css/*.css",
            "maxSize": "30KB",
            "type": "stylesheet",
            "description": "Total CSS output (TailwindCSS purged)"
        }
    ],
    "alerts": {
        "sizeIncreaseThreshold": "10%",
        "description": "Alert on any chunk size increase > 10% from baseline"
    },
    "targets": {
        "totalJS": "250KB",
        "singlePageChunk": "100KB",
        "singleDependency": "50KB",
        "totalTransfer": "500KB"
    }
}
