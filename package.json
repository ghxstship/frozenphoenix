{
  "name": "playbook",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "quality-gate": "npx tsx scripts/quality-gate.ts",
    "quality-gate:automated": "npx tsx scripts/quality-gate.ts --automated",
    "quality-gate:report": "npx tsx scripts/quality-gate.ts --report",
    "quality-gate:section": "npx tsx scripts/quality-gate.ts --section",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "stylelint": "stylelint \"src/**/*.css\"",
    "stylelint:fix": "stylelint \"src/**/*.css\" --fix",
    "predeploy": "npm run type-check && npm run lint && npm run build && npm run quality-gate:automated",
    "gen:api": "npx tsx scripts/gen-api-types.ts",
    "gen:api:spec-only": "npx tsx -e \"import{buildOpenApiSpec}from'./src/lib/openapi/spec-builder';import{writeFileSync}from'fs';writeFileSync('src/types/openapi.json',JSON.stringify(buildOpenApiSpec(),null,2))\"",
    "check:api-coverage": "npx tsx scripts/check-undocumented-endpoints.ts",
    "lint:api-spec": "npm run gen:api:spec-only && npx spectral lint src/types/openapi.json --ruleset .spectral.yml",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@atproto/oauth-client-node": "^0.3.17",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^5.2.2",
    "@mistralai/mistralai": "^1.15.1",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.97.0",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.19",
    "@use-gesture/react": "^10.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "geist": "^1.7.0",
    "groq-sdk": "^1.1.1",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.575.0",
    "mammoth": "^1.12.0",
    "motion": "^12.34.5",
    "next": "16.1.6",
    "ollama": "^0.6.3",
    "openai": "^6.29.0",
    "papaparse": "^5.5.3",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-easy-crop": "^5.5.6",
    "react-hook-form": "^7.71.2",
    "stripe": "^21.0.1",
    "tailwind-merge": "^3.5.0",
    "tiktoken": "^1.0.22",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@stoplight/spectral-cli": "^6.15.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.1.4",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.3.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.1",
    "stylelint": "^17.4.0",
    "stylelint-config-standard": "^40.0.0",
    "supabase": "^2.76.14",
    "tailwindcss": "^4",
    "ts-morph": "^27.0.2",
    "typescript": "^5",
    "vitest": "^4.0.18",
    "vitest-axe": "^0.1.0"
  }
}
